<!DOCTYPE html>
<html lang="pt-br">
    <head>
        <title>continuação 3</title>
        <meta charset="utf-8">
        
    </head>
    <body>
        <h2>Lista não ordenada</h2>
        <ul type="circule">
            <li>Livro</li>
            <li>Revista</li>
            <li>Celular</li>
            <li>Tablet</li>
        </ul>
        <ul type="square">
            <li>Livro</li>
            <li>Revista</li>
            <li>Celular</li>
            <li>Tablet</li>
        </ul>

        <h2>Lista Ordenada</h2>
        
        <ol type="A"> 
        <li>Livro</li>
        <li>Revista</li>
        <li>Celular</li>
        <li>Tablet</li>

        </ol>
    </body>
</html>
